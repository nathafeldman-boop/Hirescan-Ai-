{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && npx prisma db push; next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/email-sequence",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/journal-reminder",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/daily-quest",
      "schedule": "0 22 * * *"
    }
  ]
}
