# ─────────────────────────────────────────────────────────────────────────────
# UrSecret — Variables d'environnement
# Copie ce fichier en .env.local pour le dev, configure sur Vercel pour la prod
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (Neon PostgreSQL) ────────────────────────────────────────
# 1. Crée un compte sur https://neon.tech (gratuit)
# 2. Crée un projet "ursecret"
# 3. Dans Dashboard > Connection string, copie les deux URLs
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Génère un secret : openssl rand -base64 32
NEXTAUTH_SECRET="ton-secret-genere-ici"
# URL de production (sans / final)
NEXTAUTH_URL="https://ursecret.app"

# ── Google OAuth ─────────────────────────────────────────────────────────────
# 1. Va sur https://console.cloud.google.com
# 2. Crée un projet > APIs & Services > Credentials > OAuth 2.0 Client IDs
# 3. Type: Web Application
# 4. Authorized redirect URIs: https://ursecret.app/api/auth/callback/google
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# 1. Crée un compte sur https://resend.com (gratuit jusqu'à 3000 emails/mois)
# 2. Ajoute et vérifie ton domaine
# 3. Crée une API Key
# Format SMTP pour NextAuth EmailProvider :
EMAIL_SERVER="smtp://resend:re_xxx@smtp.resend.com:465"
EMAIL_FROM="UrSecret <noreply@ursecret.app>"

# ── Stripe ────────────────────────────────────────────────────────────────────
# 1. Crée un compte sur https://stripe.com
# 2. Mode Test → Developers > API Keys
STRIPE_SECRET_KEY="sk_live_xxx"
# 3. Crée un produit : Products > Add Product
#    Nom: "UrSecret Premium", Prix: 4.99€/mois, récurrent
#    Copie le Price ID (price_xxx)
STRIPE_PRICE_ID="price_xxx"
# 4. Configure le webhook : Developers > Webhooks > Add endpoint
#    URL: https://ursecret.app/api/webhook
#    Events: checkout.session.completed, customer.subscription.deleted
#    Copie le Signing secret
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ── IA (optionnel — pour la feature d'analyse) ────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-xxx"
