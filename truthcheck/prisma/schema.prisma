generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth models ───────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  rizzScore     Int       @default(0)
  rizzLevel     Int       @default(1)
  tier          String    @default("free") // free | pro | premium
  mbtiType      String?   // e.g. "ENTJ"
  mbtiTestCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  quizResults  QuizResult[]
  analyses     ScreenshotAnalysis[]
  emailLogs    EmailLog[]
}

model QuizResult {
  id        String   @id @default(cuid())
  quizSlug  String
  score     Int
  paid      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ScreenshotAnalysis {
  id           String   @id @default(cuid())
  userId       String?
  rawText      String
  context      String
  rizzScoreBefore Int   @default(0)
  rizzScoreAfter  Int   @default(0)
  responses    String   // JSON array of suggested responses
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model UserSession {
  id        String   @id @default(cuid())
  firstName String?
  age       String?
  gender    String?
  situation String?
  quizSlug  String
  createdAt DateTime @default(now())
}

model Affiliate {
  id            String   @id @default(cuid())
  slug          String   @unique  // e.g. "theo" → urcecret.site/?ref=theo
  name          String
  email         String?
  commissionPct Int      @default(50)
  createdAt     DateTime @default(now())

  conversions AffiliateConversion[]
}

model AffiliateConversion {
  id              String   @id @default(cuid())
  affiliateId     String
  amountCents     Int
  commissionCents Int
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])
}

model TeamRoom {
  id        String   @id  // 6-char alphanumeric code e.g. "K7P2XQ"
  slug      String
  answers   String   // base64-encoded answers from player 1
  createdAt DateTime @default(now())
}

model EmailLog {
  id     String   @id @default(cuid())
  userId String
  type   String   // welcome | day1 | day3 | day7
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model FusionGroup {
  id          String   @id @default(cuid())
  code        String   @unique // 6-char alphanumeric e.g. "K7P2XQ"
  status      String   @default("waiting") // waiting | active | complete
  questionIds Json?    // [15 randomly selected question IDs]
  resultType  String?  // e.g. "visionnaires"
  resultData  Json?    // full computed result object
  paid        Boolean  @default(false)
  createdAt   DateTime @default(now())
  participants FusionParticipant[]
}

model FusionParticipant {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  answers   Json?    // Record<number, 'A'|'B'|'C'>
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  group     FusionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model AccessCode {
  id          String    @id @default(cuid())
  code        String    @unique
  note        String?   // e.g. affiliate name or purpose
  used        Boolean   @default(false)
  usedAt      DateTime?
  usedByEmail String?
  createdAt   DateTime  @default(now())
}

model Conversion {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  email           String?
  amountCents     Int
  quizSlug        String?
  productType     String?  // 'onetime' | 'monthly' | 'annual' | 'rapport' | 'fusion'
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  affiliateSlug   String?
  landingPath     String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([utmSource])
  @@index([quizSlug])
}

model ContestEntry {
  id            String   @id @default(cuid())
  month         String   // "2026-06"
  affiliateSlug String
  affiliateName String?
  tiktokUrl     String?
  viewsCount    Int      @default(0)
  likesCount    Int      @default(0)
  sharesCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([month, affiliateSlug])
  @@index([month])
}

