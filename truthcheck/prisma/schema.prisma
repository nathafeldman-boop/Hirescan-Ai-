generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuizResult {
  id        String   @id @default(cuid())
  quizSlug  String
  score     Int
  paid      Boolean  @default(false)
  sessionId String?
  createdAt DateTime @default(now())
}

model UserSession {
  id        String   @id @default(cuid())
  firstName String?
  age       String?
  gender    String?
  situation String?
  quizSlug  String
  createdAt DateTime @default(now())
}
