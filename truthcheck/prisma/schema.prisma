generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth models ───────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  rizzScore     Int       @default(0)
  rizzLevel     Int       @default(1)
  tier          String    @default("free") // free | plus (5€) | premium (10€)
  mbtiType      String?   // e.g. "ENTJ"
  // Force de préférence par axe, calculée au test — ex :
  // { "EI": {"letter":"I","pct":68}, "SN": {...}, "TF": {...}, "JP": {...} }
  // C'est le signal unique par utilisateur qui personnalise le coach IA.
  mbtiScores    Json?
  mbtiTestCount Int       @default(0)
  // ── Parrainage (messages coach bonus) ──
  // referredById : qui a invité ce compte (réclamé via /api/referral/claim).
  // referralRewarded : le paiement 2€+ de CE compte a déjà récompensé son parrain.
  // chatBonusCredits : messages bonus one-off (+3 par inscription parrainée),
  //   consommés quand le quota du jour est épuisé.
  // chatBonusDaily : bonus PERMANENT par jour (+3 par filleul payant, plafonné).
  referredById     String?
  referralRewarded Boolean @default(false)
  chatBonusCredits Int     @default(0)
  chatBonusDaily   Int     @default(0)
  // Dernière activité authentifiée connue (posée par /api/track à chaque
  // navigation d'un utilisateur connecté — voir AppEvent pour le détail
  // événement par événement). Seule source fiable de "dernière connexion" :
  // avant ce champ, "actif" ne pouvait être QUE déduit indirectement via
  // ChatUsage/JournalEntry (imprécis, ratait toute simple visite de page).
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  quizResults  QuizResult[]
  analyses     ScreenshotAnalysis[]
  emailLogs    EmailLog[]
  chatUsage    ChatUsage[]
  chatMessages ChatMessage[]
  customQuizzes CustomQuiz[]
  conversationAnalyses ConversationAnalysis[]
  journalEntries JournalEntry[]
  compatibilityChecks CompatibilityCheck[]
  advancedAnalysis AdvancedAnalysis?
  appEvents    AppEvent[]
}

// ── Journal d'événements produit ─────────────────────────────────────────────
// Un événement horodaté par action utilisateur significative (connexion,
// message Nova envoyé, entrée de journal enregistrée, test terminé...) — voir
// lib/trackEvent.ts pour l'écriture et la liste des noms d'événements. Sert
// aux funnels et à la rétention D1/D7/D30 dans /natha-admin/insights, bien
// plus précis que les proxys déduits des tables métier après coup.
model AppEvent {
  id         String   @id @default(cuid())
  userId     String?
  event      String
  properties Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

// ── Journal émotionnel ───────────────────────────────────────────────────────
// Une entrée par jour (clé unique userId+day, upsert). La SAISIE reste
// volontairement PAS réservée aux abonnés — c'est un levier d'engagement
// quotidien à la Duolingo, utile justement pour faire revenir un compte
// gratuit avant même de payer. C'est l'ANALYSE Nova (tendances, résumés de
// période — voir lib/journalAccess.ts) qui est premium / en essai découverte.
// mood/energy/stress : échelle 1-5 chacun. energy/stress ont un défaut (3 =
// neutre) pour rester compatibles avec les lignes créées avant leur ajout.
// emotion : tag libre optionnel (ex "Joie", "Anxiété") en plus de la note —
// nullable, ajouté après coup, aucune ligne existante à migrer.
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  day       String   // "YYYY-MM-DD" (fuseau Europe/Paris)
  mood      Int      // 1 (😞) à 5 (😄)
  energy    Int      @default(3) // 1 (à plat) à 5 (pleine forme)
  stress    Int      @default(3) // 1 (zen) à 5 (sous tension)
  emotion   String?  // tag court, ex "Joie", "Gratitude", "Anxiété"
  tags      Json?    // string[] — vie perso, ex ["Travail","Amis"] (lib/journalTags.ts)
  photo     String?  @db.Text // data URI base64, capée côté API (voir MAX_PHOTO_DATA_URI_LENGTH)
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
}

// ── Compatibilité avec un ami / partenaire / membre de la famille ───────────
// L'utilisateur décrit une personne de son entourage via un court
// questionnaire de perception (ce n'est PAS le vrai test MBTI de cette
// personne — elle n'a pas de compte). Nova compare ce profil perçu au profil
// MBTI de l'utilisateur et génère un résultat pensé pour être partagé
// (réseaux sociaux) — voir /compat/[id], page publique en lecture seule.
model CompatibilityCheck {
  id           String   @id @default(cuid())
  userId       String
  personName   String
  relationType String   // 'ami' | 'couple' | 'famille'
  answers      Json     // { questionId: string, choiceLabel: string }[] — réponses perçues sur l'autre
  commonPoints Json     // string[]
  differences  Json     // string[]
  strengths    Json     // string[]
  watchPoints  Json     // string[]
  summary      String   @db.Text
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Analyse de personnalité avancée ─────────────────────────────────────────
// Va plus loin que le simple MBTI : combine le type MBTI, les scores par
// axe, les dernières analyses de conversation et le journal émotionnel pour
// donner l'impression que Nova connaît vraiment l'utilisateur. Un seul
// enregistrement par utilisateur (userId unique) : régénérer REMPLACE
// l'ancien, ce n'est pas un historique — c'est "le profil actuel de Nova sur
// toi", qui s'affine avec le temps.
model AdvancedAnalysis {
  id                  String   @id @default(cuid())
  userId              String   @unique
  strengths           Json     // string[]
  weaknesses          Json     // string[]
  communicationStyle  String   @db.Text
  conflictStyle        String   @db.Text
  idealEnvironment     String   @db.Text
  advice               Json     // string[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Analyse de conversation par Nova (feature phare, pensée pour être virale) ──
// L'utilisateur colle une conversation (texte) et/ou une capture d'écran ;
// Nova l'analyse en JSON structuré. Une ligne par analyse, jamais réécrite —
// sert d'historique consultable et de brique pour la mémoire long terme
// (Phase 2 : injecter un résumé des dernières analyses dans le contexte coach).
model ConversationAnalysis {
  id                String   @id @default(cuid())
  userId            String
  inputPreview      String   // début du texte collé, ou "[Capture d'écran]"
  personality       String   @db.Text
  attachmentStyle   String   @db.Text
  manipulationFlags String   @db.Text
  greenFlags        Json     // string[]
  redFlags          Json     // string[]
  compatibility     String   @db.Text
  emotionalLanguage String   @db.Text
  advice            String   @db.Text
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Tests créés par Nova, à partager (croissance virale) ────────────────────
// Un abonné payant demande à Nova un test sur un thème ; elle génère les
// questions + des tranches de résultat via Mistral (JSON structuré), stockées
// ici. Le test est ensuite jouable par N'IMPORTE QUI via /q/[id], sans compte
// — c'est le levier viral : chaque répondant termine sur un CTA vers le vrai
// test MBTI, avec le lien de parrainage du créateur (?invite=creatorId).
model CustomQuiz {
  id            String   @id @default(cuid())
  creatorId     String
  topic         String   // ce que l'utilisateur a demandé à Nova, ex: "mes vrais amis"
  title         String
  intro         String
  // [{ text: string, options: [{ label: string, points: number }] }]
  questions     Json
  // [{ min: number, max: number, title: string, description: string }]
  resultBands   Json
  disclaimer    String   // toujours affiché — jamais un outil de diagnostic
  responseCount Int      @default(0)
  createdAt     DateTime @default(now())

  creator   User                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  responses CustomQuizResponse[]

  @@index([creatorId])
}

model CustomQuizResponse {
  id          String   @id @default(cuid())
  quizId      String
  totalPoints Int
  createdAt   DateTime @default(now())

  quiz CustomQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

// Historique du coach IA — un enregistrement par message (utilisateur ou
// assistant). Permet la mémoire de conversation d'une session à l'autre.
// On ne recharge que les N derniers pour le contexte (coût borné).
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Compteur quotidien de messages chatbot par utilisateur — sert à appliquer
// les quotas par jour selon l'abonnement (voir lib/chat.ts). Une ligne par
// (utilisateur, jour). Rien de payant/sensible ici.
model ChatUsage {
  id     String @id @default(cuid())
  userId String
  day    String // "YYYY-MM-DD" (fuseau Europe/Paris)
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
}

model QuizResult {
  id        String   @id @default(cuid())
  quizSlug  String
  score     Int
  paid      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ScreenshotAnalysis {
  id           String   @id @default(cuid())
  userId       String?
  rawText      String
  context      String
  rizzScoreBefore Int   @default(0)
  rizzScoreAfter  Int   @default(0)
  responses    String   // JSON array of suggested responses
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model UserSession {
  id        String   @id @default(cuid())
  firstName String?
  age       String?
  gender    String?
  situation String?
  quizSlug  String
  createdAt DateTime @default(now())
}

model Affiliate {
  id            String   @id @default(cuid())
  slug          String   @unique  // e.g. "theo" → urcecret.site/?ref=theo
  name          String
  email         String?
  commissionPct Int      @default(50)
  createdAt     DateTime @default(now())

  conversions AffiliateConversion[]
}

model AffiliateConversion {
  id              String   @id @default(cuid())
  affiliateId     String
  amountCents     Int
  commissionCents Int
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])
}

model TeamRoom {
  id        String   @id  // 6-char alphanumeric code e.g. "K7P2XQ"
  slug      String
  answers   String   // base64-encoded answers from player 1
  createdAt DateTime @default(now())
}

model EmailLog {
  id     String   @id @default(cuid())
  userId String
  type   String   // welcome | day1 | day3 | day7
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  // Identifiant anonyme client (lib/visitorId.ts) — permet de compter les
  // étapes du funnel en visiteurs uniques, pas en événements bruts. Nullable
  // pour rester compatible avec les lignes existantes créées avant ce champ.
  visitorId String?
  // Attribution : d'où vient la visite. `source` = étiquette compacte calculée
  // (aff:<slug> | utm_source | hôte du referrer | direct), `referrer` = hôte brut.
  // Nullable pour les lignes créées avant ces champs.
  source    String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([visitorId])
}

model FusionGroup {
  id          String   @id @default(cuid())
  code        String   @unique // 6-char alphanumeric e.g. "K7P2XQ"
  status      String   @default("waiting") // waiting | active | complete
  questionIds Json?    // [15 randomly selected question IDs]
  resultType  String?  // e.g. "visionnaires"
  resultData  Json?    // full computed result object
  paid        Boolean  @default(false)
  createdAt   DateTime @default(now())
  participants FusionParticipant[]
}

model FusionParticipant {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  answers   Json?    // Record<number, 'A'|'B'|'C'>
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  group     FusionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model AccessCode {
  id          String    @id @default(cuid())
  code        String    @unique
  note        String?   // e.g. affiliate name or purpose
  used        Boolean   @default(false)
  usedAt      DateTime?
  usedByEmail String?
  createdAt   DateTime  @default(now())
}

model Conversion {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  email           String?
  amountCents     Int
  quizSlug        String?
  productType     String?  // 'onetime' | 'monthly' | 'annual' | 'rapport' | 'fusion'
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  affiliateSlug   String?
  landingPath     String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([utmSource])
  @@index([quizSlug])
}

model ContestEntry {
  id            String   @id @default(cuid())
  month         String   // "2026-06"
  affiliateSlug String
  affiliateName String?
  tiktokUrl     String?
  viewsCount    Int      @default(0)
  likesCount    Int      @default(0)
  sharesCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([month, affiliateSlug])
  @@index([month])
}

