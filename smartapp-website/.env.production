# PostHog configuration for production builds.
# These NEXT_PUBLIC_* values are inlined into the client bundle at build time
# (next build reads .env.production because NODE_ENV=production), so the
# GitHub Pages deployment build picks them up automatically. The PostHog
# project token is a public client-side token, safe to ship in the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_vuG5oAgMRb7SZ4or2D25VHvmurYLyKLmh8Qt2PZZqGoj
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
